# Виртуальное окружение
.venv/

# Данные (скачиваются отдельно, не храним в git)
data/*
!data/.gitkeep

# Обученные модели (веса — большие бинарники)
models/*
!models/.gitkeep

# Python кэш и служебные файлы
__pycache__/
*.pyc
.ipynb_checkpoints/

# Переменные окружения / секреты (если появятся API-ключи и т.п.)
.env

# IDE
.vscode/
.idea/